{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "suraido.js",
    "paths": {
      "suraido.js/jsx-runtime": ["./src/jsx-runtime.ts"],
      "suraido.js/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"]
}
