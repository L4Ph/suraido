{
  "name": "suraido.js",
  "version": "0.4.0",
  "description": "スライド — write slides in JSX. No React, no dependencies.",
  "keywords": [
    "deck",
    "jsx",
    "presentation",
    "slides",
    "slideshow",
    "talk"
  ],
  "homepage": "https://github.com/L4Ph/suraido#readme",
  "bugs": "https://github.com/L4Ph/suraido/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L4Ph/suraido.git",
    "directory": "packages/suraido"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "default": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "default": "./dist/jsx-dev-runtime.mjs"
    },
    "./deck.css": "./dist/deck.css",
    "./themes/*.css": "./dist/themes/*.css"
  },
  "devDependencies": {
    "happy-dom": "^20.0.0"
  }
}
