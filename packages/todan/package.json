{
  "name": "todan",
  "version": "0.1.0",
  "description": "登壇 — write slides in JSX. No React, no virtual DOM.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.mts",
      "default": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.mts",
      "default": "./dist/jsx-dev-runtime.mjs"
    },
    "./deck.css": "./dist/deck.css",
    "./themes/*.css": "./dist/themes/*.css"
  },
  "devDependencies": {
    "happy-dom": "^20.0.0"
  }
}
