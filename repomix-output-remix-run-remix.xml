  Assert<IsEqual<
    JoinPatterns<'https://example.com:8080/base', 'http:///next'>,
    'http://example.com:8080/base/next'
  >>,

  Assert<IsEqual<
    JoinPatterns<'/base', ':proto://example.com/path'>,
    never
  >>
